class linearinequalities {

	basic() {
		def i = 1;
		def y = 1;
        def z = 1;
        if (i >= y + z) {
            def w = 1;
        } else {
            def w = 0;
        }
	}

	 multi_constraints(x) {
        def a = 1;
        def b = 1;
        def c = 1;
        def d = 1;
        if (a >= b + c) {
            if (a >= c + d) {
                def w = 1;
            }
        }
     }

     lub_test(x) {
         def a = 1;
         def b = 1;
         def c = 1;
         def w = 0;
         if (a >= b + c) {
             w = 1;
         } else {
             w = 2;
         }
     }

     reassign(x) {
         def a = 1;
         def b = 1;
         def c = 1;
         if (a >= b + c) {
             b = 2;
         }
     }

     transitive(x) {
         def a = 1;
         def b = 1;
         def c = 1;
         def d = 1;
         if (a >= b + c) {
             if (b >= c + d) {
                 def w = 1;
             }
         }
     }

}