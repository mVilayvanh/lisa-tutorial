class intervalsoverflow {

    basic() {
        def x = 1;
        def y = 2;
        def z = x + y;

        def a = 20;
        if (z > 0)
            a = 10;

        def b = a - 5;
        return b;
    }

    overflow() {
        def x = 2147483647;
        def y = x + 1;
        return y;
    }

    loop() {
        def c = 1;
        def b = 0;
        while (b < 10)
            b = b + c;
        return b;
    }
}