class intervalsoverflow {

    basic() {
        def x = 1;
        def y = 2;
        def z = x + y;

        def a = 20;
        if (z > 0)
            a = 10;

        def b = a - 5;
        return b;
    }

    overflow_add() {
        def x = 2147483647;
        def y = x + 1;
        return y;
    }

    overflow_sub() {
        def m = 2147483647;
        def x = -m;
        x = x - 1;
        def y = x - 1;
        return y;
    }

    overflow_neg() {
        def m = 2147483647;
        def x = -m;
        x = x - 1;
        def y = -x;
        return y;
    }

    overflow_div() {
        def m = 2147483647;
        def x = -m;
        x = x - 1;
        def y = -1;
        def z = x / y;
        return z;
    }

    loop() {
        def c = 1;
        def b = 0;
        while (b < 10)
            b = b + c;
        return b;
    }
}