class intervalsoverflow {

    basic() {
        def x = 1;
        def y = 2;
        def z = x + y;

        def a = 20;
        if (z > 0)
            a = 10;

        def b = a - 5;
        return b;
    }

    mul_basic() {
        def x = 2;
        def y = 3;
        def z = x * y;
        return z;
    }

    overflow_add() {
        def x = 2147483647;
        def y = x + 1;
        return y;
    }

    overflow_sub() {
        def m = 2147483647;
        def x = -m;
        x = x - 1;
        def y = x - 1;
        return y;
    }

    overflow_mul() {
        def x = 2147483647;
        def y = 2;
        def z = x * y;
        return z;
    }

    overflow_neg() {
        def m = 2147483647;
        def x = -m;
        x = x - 1;
        def y = -x;
        return y;
    }

    overflow_div() {
        def m = 2147483647;
        def x = -m;
        x = x - 1;
        def y = -1;
        def z = x / y;
        return z;
    }

    loop() {
        def c = 1;
        def b = 0;
        while (b < 10)
            b = b + c;
        return b;
    }

    assume_eq_true() {
        def x = 5;
        if (x == 5)
            x = x + 1;
        return x;
    }

    assume_eq_false() {
        def x = 5;
        if (x == 6)
            x = x + 100;
        return x;
    }

    assume_ne_true() {
        def x = 5;
        if (x != 6)
            x = x + 1;
        return x;
    }

    assume_lt_true() {
        def x = 3;
        if (x < 5)
            x = x + 10;
        return x;
    }

    assume_le_true() {
        def x = 5;
        if (x <= 5)
            x = x + 1;
        return x;
    }

    assume_gt_true() {
        def x = 8;
        if (x > 3)
            x = x - 2;
        return x;
    }

    assume_ge_true() {
        def x = 8;
        if (x >= 8)
            x = x + 2;
        return x;
    }

    loop_eq_guard() {
        def x = 0;
        while (x < 3)
            x = x + 1;
        return x;
    }
}